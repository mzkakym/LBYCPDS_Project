<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #F8F9FC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.lbycpds_project.controllers.Staff_controller">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="56" spacing="10" style="-fx-background-color: white;                      -fx-border-color: #E1E1E1;                      -fx-border-width: 0 0 1 0;                      -fx-padding: 8 20 8 20;">
         <ImageView fitHeight="33.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../../images/Logo.png" />
            </image></ImageView>

            <Label style="-fx-text-fill: #006738;                           -fx-font-size: 16;                           -fx-font-weight: bold;" text="DLSU" />

            <Label style="-fx-text-fill: #6E6E6E;                           -fx-font-size: 13;" text="Electronics Inventory System" />

            <StackPane HBox.hgrow="ALWAYS" />

            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="staffNameLabel" style="-fx-font-weight: bold;                               -fx-font-size: 12;" text="LABORATORY STAFF" />

                <Label fx:id="staffIdLabel" style="-fx-font-size: 12;" text="STAFF ID" />
            </VBox>

        </HBox>
    </top>

    <!-- LEFT NAVIGATION -->
    <left>
        <VBox fx:id="navigationBox" minWidth="230" prefWidth="230" spacing="0" style="-fx-background-color: white;                      -fx-border-color: #E1E1E1;                      -fx-border-width: 0 1 0 0;" />
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #F8F9FC;" />
    </center>

</BorderPane>
