<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="borrower-root"
            stylesheets="@../../css/borrower.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.lbycpds_project.controllers.Borrower_controller">

    <!-- HEADER -->
    <top>
        <HBox styleClass="header" spacing="16.0">
            <VBox spacing="2.0">
                <Label styleClass="header-title" text="Borrower Dashboard" />
                <Label fx:id="welcomeLabel" styleClass="header-sub" text="" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleLogout" text="⏻" />
        </HBox>
    </top>

    <center>
        <TabPane fx:id="mainTabs" tabClosingPolicy="UNAVAILABLE">

            <!-- 1. SEARCH ITEMS -->
            <Tab text="Search Items">
                <VBox spacing="14.0" styleClass="page">
                    <Label styleClass="page-heading" text="Search equipment" />
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="field-name" text="Search by" />
                        <ComboBox fx:id="searchByBox" prefWidth="130.0" />
                        <TextField fx:id="keywordField" onAction="#handleSearch" promptText="Enter a keyword or ID" HBox.hgrow="ALWAYS" />
                        <CheckBox fx:id="onlyAvailableBox" text="Only show available items" />
                        <Button onAction="#handleSearch" styleClass="primary" text="Search" />
                        <Button onAction="#handleRecentSearches" text="Recent Searches" />
                    </HBox>
                    <Label fx:id="searchMessageLabel" text="" />
                    <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                            <TableColumn fx:id="colName" prefWidth="220.0" text="Name" />
                            <TableColumn fx:id="colCategory" prefWidth="130.0" text="Category" />
                            <TableColumn fx:id="colBrand" prefWidth="130.0" text="Brand" />
                            <TableColumn fx:id="colLocation" prefWidth="120.0" text="Location" />
                            <TableColumn fx:id="colAvail" prefWidth="100.0" text="Available" />
                            <TableColumn fx:id="colCondition" prefWidth="110.0" text="Condition" />
                            <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT">
                        <Button onAction="#handleRequestSelected" styleClass="primary" text="Request Selected Item" />
                    </HBox>
                </VBox>
            </Tab>

            <!-- 2. CHECK AVAILABILITY -->
            <Tab text="Check Availability">
                <VBox spacing="14.0" styleClass="page">

                    <Label styleClass="page-heading"
                           text="Check availability" />

                    <HBox alignment="CENTER_LEFT" spacing="12.0">

                        <Label styleClass="field-name"
                               text="Equipment name" />

                        <TextField fx:id="availNameField"
                                   onAction="#handleCheckAvailability"
                                   prefWidth="260.0"
                                   promptText="e.g. Multimeter" />

                        <Button onAction="#handleCheckAvailability"
                                styleClass="primary"
                                text="Check" />

                    </HBox>

                    <Label fx:id="availMessageLabel" text="" />

                    <TableView fx:id="availabilityTable"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="availColId"
                                         prefWidth="75.0"
                                         text="ID" />

                            <TableColumn fx:id="availColName"
                                         prefWidth="150.0"
                                         text="Equipment" />

                            <TableColumn fx:id="availColBrand"
                                         prefWidth="130.0"
                                         text="Brand" />

                            <TableColumn fx:id="availColTotal"
                                         prefWidth="85.0"
                                         text="Total" />

                            <TableColumn fx:id="availColAvailable"
                                         prefWidth="95.0"
                                         text="Available" />

                            <TableColumn fx:id="availColBorrowed"
                                         prefWidth="95.0"
                                         text="Borrowed" />

                            <TableColumn fx:id="availColCondition"
                                         prefWidth="100.0"
                                         text="Condition" />

                            <TableColumn fx:id="availColLocation"
                                         prefWidth="110.0"
                                         text="Location" />

                            <TableColumn fx:id="availColStatus"
                                         prefWidth="120.0"
                                         text="Status" />

                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>

                    </TableView>

                </VBox>
            </Tab>

            <!-- 3. REQUEST FOR ITEM -->
            <Tab fx:id="requestTab" text="Request Item">
                <VBox spacing="14.0" styleClass="page">
                    <Label styleClass="page-heading" text="Request an item" />
                    <Label styleClass="hint" text="Add one or more equipment items. If an item exceeds available stock, you can join the reservation queue." />
                    <GridPane hgap="16.0" maxWidth="700.0" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="230.0" prefWidth="230.0" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>
                        <Label styleClass="field-name" text="Equipment items" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <VBox fx:id="requestItemsBox" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Button onAction="#handleAddRequestItem" text="Add equipment" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label styleClass="field-name" text="Purpose" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="reqPurposeField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label styleClass="field-name" text="Subject / laboratory activity" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="reqActivityField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label styleClass="field-name" text="Expected return date" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <DatePicker fx:id="returnDatePicker" editable="false" prefWidth="260.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </GridPane>
                    <HBox spacing="12.0">
                        <Button onAction="#handleSubmitRequest" styleClass="primary" text="Submit Request" />
                        <Button onAction="#handleClearRequestForm" text="Clear" />
                    </HBox>
                    <Label fx:id="requestMessageLabel" text="" />
                </VBox>
            </Tab>

            <!-- 4. STATUS OF REQUESTS -->
            <Tab text="My Requests">
                <VBox spacing="14.0" styleClass="page">
                    <Label styleClass="page-heading" text="Status of your requests" />
                    <Label styleClass="hint" text="Double-click a request to view its requested items and return dates." />
                    <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colTxn" prefWidth="220.0" text="Borrower" />
                            <TableColumn fx:id="colReqItem" prefWidth="120.0" text="ID" />
                            <TableColumn fx:id="colReqQty" prefWidth="130.0" text="Date Requested" />
                            <TableColumn fx:id="colReqDate" prefWidth="190.0" text="Status" />
                            <TableColumn fx:id="colReqReturn" visible="false" />
                            <TableColumn fx:id="colReqStatus" visible="false" />
                            <TableColumn fx:id="colReqRemarks" visible="false" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
