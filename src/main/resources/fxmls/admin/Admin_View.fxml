<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.lbycpds_project.controllers.Admin_controller"
            prefWidth="1280.0"
            prefHeight="720.0"
            style="-fx-background-color: #F8F9FC;">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="10"
              prefHeight="56"
              style="-fx-background-color: white;
                     -fx-border-color: #E1E1E1;
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 8 20 8 20;">

            <Label text="DLSU"
                   style="-fx-text-fill: #006738;
                          -fx-font-size: 16;
                          -fx-font-weight: bold;"/>

            <Label text="Electronics Inventory System"
                   style="-fx-text-fill: #6E6E6E;
                          -fx-font-size: 13;"/>

            <StackPane HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="2">

                <Label fx:id="adminNameLabel"
                       text="ADMINISTRATOR"
                       style="-fx-font-weight: bold;
                              -fx-font-size: 12;"/>

                <Label fx:id="adminIdLabel"
                       text="ADMIN ID"
                       style="-fx-font-size: 12;"/>

            </VBox>

        </HBox>
    </top>

    <!-- LEFT NAVIGATION -->
    <left>
        <VBox fx:id="navigationBox"
              prefWidth="230"
              minWidth="230"
              spacing="0"
              style="-fx-background-color: white;
                     -fx-border-color: #E1E1E1;
                     -fx-border-width: 0 1 0 0;"/>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentPane"
                   style="-fx-background-color: #F8F9FC;"/>
    </center>

</BorderPane>
