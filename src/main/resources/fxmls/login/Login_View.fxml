<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0"
           prefWidth="1280.0"
           styleClass="login-root"
           stylesheets="@../../css/login.css"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.lbycpds_project.controllers.Login_controller">

    <!-- BACKGROUND IMAGE -->
    <ImageView fx:id="backgroundImage"
               fitHeight="720.0"
               fitWidth="1280.0"
               preserveRatio="false">
        <image>
            <Image url="@../../images/Login_View.jpg" />
        </image>
    </ImageView>

    <!-- LOGIN CONTENT -->
    <AnchorPane fx:id="loginPane"
                prefHeight="720.0"
                prefWidth="1280.0">

        <children>

            <VBox fx:id="loginContainer"
                  layoutX="671.0"
                  layoutY="216.0"
                  prefHeight="243.0"
                  prefWidth="399.0"
                  spacing="15.0">

                <!-- USER ID -->
                <Label text="User ID"
                       styleClass="login-label"/>

                <TextField fx:id="userIDField"
                           prefHeight="51.0"
                           prefWidth="86.0"
                           promptText="Enter your User ID"
                           styleClass="login-field"/>

                <!-- PASSWORD -->
                <Label text="Password"
                       styleClass="login-label"/>

                <PasswordField fx:id="passwordField"
                               prefHeight="54.0"
                               prefWidth="399.0"
                               promptText="Enter your Password"
                               styleClass="login-field"/>

                <!-- ERROR MESSAGE -->
                <Label fx:id="messageLabel"
                       text=""
                       styleClass="error-label"/>

                <!-- LOGIN BUTTON -->
                <Button fx:id="loginButton"
                        contentDisplay="CENTER"
                        graphicTextGap="1.0"
                        onAction="#handleLogin"
                        text="Login"
                        styleClass="login-button"
                        maxWidth="Infinity">
                </Button>

            </VBox>

            <!-- FORGOT PASSWORD -->
            <Button fx:id="forgotPasswordButton"
                    layoutX="671.0"
                    layoutY="518.0"
                    onAction="#handleForgotPassword"
                    prefHeight="25.0"
                    prefWidth="120.0"
                    text="Forgot Password"
                    styleClass="secondary-button"/>

            <!-- CREATE ACCOUNT -->
            <Button fx:id="activateAccountButton"
                    layoutX="802.0"
                    layoutY="518.0"
                    onAction="#handleCreateAccount"
                    prefHeight="25.0"
                    prefWidth="120.0"
                    text="Create Account"
                    styleClass="secondary-button"/>

        </children>

    </AnchorPane>

</StackPane>

